# Copy to .env.local or .env (both gitignored); `eve dev` loads them automatically.
# Restart eve dev after changes.

# Required: every agent calls Anthropic directly with this key.
ANTHROPIC_API_KEY=

# Required: the project folder the squad works on. Created if it does not exist.
SQUAD_TARGET=~/Projects/my-app

# Optional: where spec, tickets, and reports go. Default: $SQUAD_TARGET/.squad
# SQUAD_ARTIFACTS=~/squad-artifacts/my-app

# Optional: write tickets as GitHub issues instead of local files.
# Token: fine-grained PAT on the repo with Issues and Pull requests read/write; for a Projects
# board use a classic PAT with the `repo` and `project` scopes. Pushing branches uses your own
# git credentials (SSH key), not this token, so the repo must exist and `git push` must work.
# SQUAD_GITHUB_REPO=cktsang/my-app
# SQUAD_GITHUB_PROJECT=1
# GITHUB_TOKEN=
